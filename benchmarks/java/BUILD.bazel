load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_library(
    name = "shmipc_benchmark_java",
    srcs = glob(
        ["src/main/java/**/*.java"]
    ),
    deps = [
        "//java:shmipc_java",
        "@maven_shmipc//:org_hdrhistogram_HdrHistogram",
    ],
    javabuilder_jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    runtime_deps = ["//core:shmipc_shared"],
    visibility = ["//visibility:public"]
)


java_binary(
    name = "shm_pingpong_producer",
    main_class = "lib.shm.ipc.benchmark.actors.ShmPingPongProducer",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    data = ["//core:libshmipc_shared.dylib"],
    runtime_deps = [
        ":shmipc_benchmark_java"
    ]
)

java_binary(
    name = "shm_pingpong_consumer",
    main_class = "lib.shm.ipc.benchmark.actors.ShmPingPongConsumer",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    data = ["//core:libshmipc_shared.dylib"],
    runtime_deps = [
        ":shmipc_benchmark_java"
    ]
)

java_binary(
    name = "orchestrator",
    main_class = "lib.shm.ipc.benchmark.Orchestrator",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    data = ["//core:libshmipc_shared.dylib"],
    runtime_deps = [
        ":shmipc_benchmark_java"
    ]
)

java_binary(
    name = "runner",
    main_class = "lib.shm.ipc.benchmark.Runner",
    jvm_flags = ["--enable-native-access=ALL-UNNAMED"],
    data = ["//core:libshmipc_shared.dylib"],
    runtime_deps = [
        ":shmipc_benchmark_java"
    ]
)

filegroup(
    name = "benchmarks_bins",
    srcs = [
        ":shm_pingpong_producer",
        ":shm_pingpong_consumer",
        ":orchestrator",
        ":runner"
    ],
    visibility = ["//visibility:public"],
)